# Optional local settings. Copy to personal.env; keep that file private.
# Character setup stores Bluetooth settings in ~/.clauddy/config.

# Optional remote Studio. Omit these for local-only use.
# Use your relay account, not the sender account. See docs/remote-studio.md.
# export FIREBASE_DB_URL="https://YOUR_PROJECT-default-rtdb.firebaseio.com"
# export FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# export FIREBASE_EMAIL="relay@example.com"
# export FIREBASE_PASSWORD="YOUR_RELAY_PASSWORD"

# Default is the full 160x128 display. Use 128 to try square media instead.
# export LIVE_STUDIO_SIZE=128
